---
import type { CollectionEntry } from "astro:content";

interface Props {
  course: Pick<CollectionEntry<"courses">["data"], "cover" | "shortTitle" | "tagline" | "topics">;
}

const { course } = Astro.props;
const coverUrl = course.cover
  ? `${import.meta.env.BASE_URL}${course.cover.slice(1)}`
  : undefined;
---

<div class="course-art" aria-hidden="true">
  <span class="tagline">{course.tagline}</span>
  {coverUrl ? (
    <img class="cover-image" src={coverUrl} alt="" width="400" height="190" loading="lazy" decoding="async" />
  ) : (
    <strong class="cover-title">{course.shortTitle}</strong>
  )}
  <div class="topics">
    {course.topics.map((topic) => <span>{topic}</span>)}
  </div>
</div>

<style>
  .course-art {
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    min-width:0;
    min-height:310px;
    padding:26px 30px;
    background:var(--pale);
    border-right:1px solid var(--line);
  }
  .tagline { font-size:.8125rem; color:var(--muted); }
  .cover-image {
    display:block;
    width:100%;
    max-width:390px;
    height:auto;
    aspect-ratio:400 / 190;
    object-fit:contain;
    align-self:center;
    margin:16px 0;
  }
  .cover-title {
    font-size:2.875rem;
    line-height:1.25;
    letter-spacing:-.035em;
    font-weight:650;
    overflow-wrap:anywhere;
    margin:24px 0;
  }
  .topics { display:flex; flex-wrap:wrap; gap:8px; font-size:.75rem; color:var(--muted); }
  .topics span + span::before { content:"/"; color:#9bada8; margin-right:8px; }
  @media(max-width:900px) {
    .course-art { padding:26px; }
    .cover-title { font-size:2.4375rem; }
  }
  @media(max-width:650px) {
    .course-art { min-height:220px; border-right:0; border-bottom:1px solid var(--line); padding:24px; gap:4px; }
    .cover-title { font-size:2.375rem; }
    .cover-image { max-width:320px; margin:0 auto; }
  }
</style>
