---
import "../styles/home.css";
import { getCollection } from "astro:content";
import CourseCover from "../components/CourseCover.astro";

const base = import.meta.env.BASE_URL;
const courses = (await getCollection("courses")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = courses[0];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" /><meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>AI 讀書會｜一起學，把想法做出來</title>
    <meta
      name="description"
      content="AI 讀書會的學習工作室。找到實作教材、回顧讀書會主題，透過 Learning Map 探索下一步。"
    />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
  </head>

  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <div class="wrap">
      <header class="header">
        <a class="brand" href={base} aria-label="AI 讀書會首頁">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"
            ><rect width="32" height="32" rx="9" fill="#168579"></rect><path
              d="M8 10h7v13H8zm9 0h7v13h-7"
              stroke="white"
              stroke-width="1.5"></path><path
              d="m10 15 2-2 2 2m4 3 2 2 2-2"
              stroke="white"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>AI 讀書會</a
        >

        <nav class="nav" aria-label="主要導覽">
          <a href="#materials">讀書會教材</a>
          <a href="#learning-map">學習地圖</a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="hello">歡迎來到我們的學習工作室</div>
            <h1 id="hero-title">一起學 AI，<br />把想法「做」出來！</h1>
            <p>
              從「這是什麼」到「我也做到了」!<br />一起探索工具、動手練習，把每次讀書會的收穫，變成自己的能力!
            </p><div class="actions">
              <a class="button" href="#materials">瀏覽教學資源</a><a
                class="text-link"
                href="#learning-map">探索學習方向</a>
            </div>
          </div>
          <div class="hero-board">
            <article class="note">
              <div class="note-head">
                <span>近期讀書會</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
                  ><path
                    d="M6 3h12v18l-6-4-6 4V3Z"
                    stroke="currentColor"
                    stroke-width="1.6"></path>
                </svg>
              </div>
              <h2>探索一個主題，<br />帶走新的可能。</h2>
              <p>{featured?.data.title}</p>
              <svg
                class="branch"
                viewBox="0 0 330 105"
                role="img"
                aria-label="從認識主題到動手練習，再與夥伴交流分享"
                ><path
                  d="M28 70h270M90 70C116 70 110 28 140 28h54c31 0 25 42 55 42"
                  stroke="#a4bcb5"
                  stroke-width="2.5"
                  fill="none"></path><path
                  d="M90 70C116 70 110 28 140 28h54c31 0 25 42 55 42"
                  stroke="#168579"
                  stroke-width="2.5"
                  fill="none"></path><g
                  fill="white"
                  stroke="#168579"
                  stroke-width="2.5"
                  ><circle cx="32" cy="70" r="6"></circle><circle
                    cx="90"
                    cy="70"
                    r="6"></circle><circle cx="249" cy="70" r="6"
                  ></circle><circle cx="298" cy="70" r="6"></circle></g
                ><g fill="#168579"
                  ><circle cx="142" cy="28" r="5"></circle><circle
                    cx="194"
                    cy="28"
                    r="5"></circle></g
                ><g fill="#52677b" font-family="sans-serif" font-size="11"
                  ><text x="16" y="97">開始</text><text x="148" y="12"
                    >動手練習</text
                  ><text x="258" y="97">交流分享</text></g
                >
              </svg><div class="note-bottom">
                <span
                  >{featured?.data.audience} · {featured?.data.duration} 分鐘</span
                ><a
                  href={featured
                    ? `${base}courses/${featured.id}/`
                    : "#materials"}>開始學習</a>
              </div>
            </article><div class="desk-label">動手試試，比想像中更靠近。</div>
          </div>
        </section>
        <div class="intro-strip">
          <strong>每次學一點，每次做一點。</strong>
          <p>
            這裡收錄了講者們分享的多元學習資源，讓你課前準備、課後複習都找得到！
          </p>
        </div>

        <section
          class="materials"
          id="materials"
          aria-labelledby="materials-title"
        >
          <div class="section-head">
            <div>
              <h2 id="materials-title">讀書會教材</h2>
              <p>多元的學習資源，幫你從不同角度探索 AI、補強軟體基礎知識</p>
            </div><span class="count">目前收錄 {courses.length} 個主題</span>
          </div>

          {
            courses.map((course) => (
              <article class="course" id={`course-${course.id}`}>
                <CourseCover course={course.data} />
                <div class="course-body">
                  <div class="tags">
                    {course.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <h3>
                    <a href={`${base}courses/${course.id}/`}>
                      {course.data.title}
                    </a>
                  </h3>
                  <p>{course.data.description}</p>
                  <div class="course-meta">
                    <>
                      <span>{course.data.audience}</span>
                      <span>約 {course.data.duration} 分鐘</span>
                      <span>投影片・實作指南・延伸閱讀</span>
                    </>
                  </div>
                  <div class="download-row">
                    <a class="button" href={`${base}courses/${course.id}/`}>
                      開始學習 <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </section>

        <section
          class="map-section"
          id="learning-map"
          aria-labelledby="map-title"
        >
          <div class="section-head">
            <div>
              <h2 id="map-title">學習地圖</h2>
              <p>把每次學習，連成自己的路線。</p>
            </div>
          </div>
          <a
            class="map-panel"
            href="https://synapse-learning-map.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="map-copy">
              <h3>找到下一個想探索的方向</h3>
              <p>看看主題之間的關聯，回顧走過的路，也找到下一步想學的內容。</p>
              <span class="map-cta">開啟學習地圖 <span aria-hidden="true">↗</span></span>
              <span class="map-hint">前往 Learning Map，於新分頁開啟</span>
            </div>
            <div class="map-preview">
              <img
                src={`${base}learning-map.png`}
                alt="真實學習地圖預覽：Transformer 連結 Attention、Embedding，並延伸至 Vector Database 與 RAG 等主題。"
                width="1471"
                height="771"
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>
        </section>
      </main>
      <footer>
        <div class="footer-inner">
          <div>
            <strong>AI 讀書會</strong>
            <p>一起探索、動手實作，把學到的留下來。</p>
          </div><a href="#main">回到頁首 ↑</a>
        </div>
      </footer>
    </div>
  </body>
</html>
